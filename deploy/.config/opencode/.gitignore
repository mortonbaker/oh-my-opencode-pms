# oh-my-opencode-pms harness config — tracked in agent-stack
# Anything below is excluded from version control.

# Secrets & auth — NEVER commit
**/auth.json
**/.credentials.json
**/*.token
**/*-token*

# Auto-regenerated by opencode/bun (not configuration)
node_modules/
package.json
package-lock.json
bun.lock

# Session/runtime state (lives elsewhere anyway, but defensive)
opencode.db*
*.log

# Local-only state (per-session, per-machine)
agent_metadata.json

# Backup cruft from earlier migrations
*.bak
*.bak-*
*.backup-*
*.previous
*.disabled*
_attic/
